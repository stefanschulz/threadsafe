{
    "name": "stefanschulz/threadsafe",
    "description": "Multi-site backup and migration tool for PHP web applications (first target: PrestaShop 9).",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "bin": [
        "bin/threadsafe"
    ],
    "autoload": {
        "psr-4": {
            "ThreadSafe\\": "src/",
            "ThreadSafe\\PrestaShop9\\": "plugins/prestashop9/src/",
            "ThreadSafe\\Generic\\": "plugins/generic/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThreadSafe\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "parallel-lint --colors src plugins tests tools",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:bundle": [
            "php tools/build-restore.php --bundle=build/bundle.php",
            "php -d auto_prepend_file=tools/prepend-bundle.php vendor/bin/phpunit --testsuite unit"
        ],
        "check": [
            "@lint",
            "@stan",
            "@test",
            "@test:bundle"
        ]
    },
    "scripts-descriptions": {
        "lint": "Syntax check of all PHP files",
        "stan": "Static analysis (PHPStan)",
        "test": "Unit tests (no database needed)",
        "test:integration": "Integration tests (need the Docker stacks, see tests/stack/run.sh)",
        "test:bundle": "The unit tests again, against the bundled code that restore.php is made of",
        "check": "Lint, static analysis, unit tests, unit tests against the bundle"
    }
}
