parameters:
    level: 8
    paths:
        - src
        - plugins
        - tests
    excludePaths:
        # runs inside the PrestaShop container in a child process (needs PrestaShop's classes)
        - plugins/prestashop9/resources/finalize.php
        # PrestaShop module that only runs inside the Docker test stack
        - tests/fixtures
        # runs inside the PrestaShop container (needs PrestaShop's classes)
        - tests/stack/oracle
    # tools/ holds throw-away phase 0 scripts (syntax-checked by `composer lint`, not analysed).
    tmpDir: .cache/phpstan
    ignoreErrors:
        # The integration tests open their PDO connections with ERRMODE_EXCEPTION, so query() never returns false there; a
        # `->query(...)?->fetchColumn()` chain is how they read one value.
        -
            identifier: nullsafe.neverNull
            path: tests/*
        -
            message: '#Cannot call method (fetchColumn|fetch|fetchAll)\(\) on PDOStatement\|false#'
            path: tests/*
