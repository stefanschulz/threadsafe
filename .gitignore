# IDE
.idea/
.vscode/

# Dependencies / build
/vendor/
/build/
/dist/
/build.properties

# Local environment
.docker/.env
*.local

# Real backups and customer data must NEVER enter the repository (see docs/CONCEPT.md, section 7)
/private/
*.jpa
*.j[0-9][0-9]
*.z[0-9][0-9]
*.zip
*.sql
*.sql.gz
*.tsv

# Tool caches
/.cache/

# Test fixtures (SQL seed) are the exception to the *.sql rule above
!/tests/fixtures/*.sql

# ThreadSafe's own working data: site profiles (may hold database passwords), run states, module rules, locks
/data/
