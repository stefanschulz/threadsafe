# ThreadSafe installed below a web root without pointing the document root at public/: nothing here is for the web, except
# what public/.htaccess opens again. Better still: make public/ the document root (docs/PHASE4.md 3.1).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
