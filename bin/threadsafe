#!/usr/bin/env php
<?php

declare(strict_types=1);

use ThreadSafe\Cli\AdminCommand;
use ThreadSafe\Cli\Application;
use ThreadSafe\Cli\BackupCommand;
use ThreadSafe\Cli\BackupsCommand;
use ThreadSafe\Cli\CommandLine;
use ThreadSafe\Cli\CronCommand;
use ThreadSafe\Cli\DoctorCommand;
use ThreadSafe\Cli\KeysCommand;
use ThreadSafe\Cli\MigrateCommand;
use ThreadSafe\Cli\ProfileCommand;
use ThreadSafe\Cli\RestoreCommand;
use ThreadSafe\Cli\RetentionCommand;
use ThreadSafe\Cli\StreamOutput;
use ThreadSafe\Cli\UpdateCommand;
use ThreadSafe\Cli\VerifyCommand;

// The PHP CGI binary ("php-cgi", often the only PHP 8 on shared hosting) runs scripts from a shell too, but defines no STDERR
// constant, has a time limit of its own and prints HTML errors: make it behave like the command line version.
if (PHP_SAPI !== 'cli') {
    @set_time_limit(0);
    @ini_set('html_errors', '0');
}

if (PHP_VERSION_ID < 80400) {
    fwrite(defined('STDERR') ? STDERR : fopen('php://stderr', 'wb'), "ThreadSafe needs PHP 8.4 or newer (this is " . PHP_VERSION . ").\n");
    exit(1);
}

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(defined('STDERR') ? STDERR : fopen('php://stderr', 'wb'), "Dependencies are missing: run \"composer install\".\n");
    exit(1);
}
require $autoload;

// the data directory is brought to the format of this release; data of a newer program is not touched (docs/PHASE7.md 3.6)
try {
    (new ThreadSafe\Update\Migrator(ThreadSafe\Update\Migrations::all()))->ensure(ThreadSafe\Core\Paths::data());
} catch (ThreadSafe\Update\UpdateException $e) {
    fwrite(defined('STDERR') ? STDERR : fopen('php://stderr', 'wb'), 'error: ' . $e->getMessage() . "\n");
    exit(2);
}

$application = new Application([new MigrateCommand(), new ProfileCommand(), new BackupCommand(), new BackupsCommand(), new VerifyCommand(), new RestoreCommand(), new CronCommand(), new RetentionCommand(), new KeysCommand(), new AdminCommand(), new DoctorCommand(), new UpdateCommand()]);

// The CGI binary hands over no $argv if register_argc_argv is off (php.ini-production does that): read the command line from the process then.
$arguments = CommandLine::arguments($argv ?? null, defined('THREADSAFE_SCRIPT') ? (string) constant('THREADSAFE_SCRIPT') : __FILE__);
if ($arguments === null) {
    fwrite(defined('STDERR') ? STDERR : fopen('php://stderr', 'wb'), "PHP does not pass the command line arguments (register_argc_argv is off for this PHP binary). Run it with -d register_argc_argv=1, e.g. \"php-cgi -q -d register_argc_argv=1 bin/threadsafe ...\".\n");
    exit(1);
}

exit($application->run($arguments, StreamOutput::standard()));
